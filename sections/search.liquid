{% comment %}
  Main search results section (search template).
  Large search field, product results in the shared card grid,
  page and article results as hairline rows, token-based pagination.
{% endcomment %}

<div class="fl-searchpage">
  <header class="fl-searchpage__head">
    <h1 class="fl-searchpage__title">{{ 'search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="fl-searchpage__form">
      <label class="visually-hidden" for="FlSearchInput-{{ section.id }}">
        {{ 'search.title' | t }}
      </label>
      <input
        type="search"
        id="FlSearchInput-{{ section.id }}"
        class="fl-input fl-searchpage__input"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
      >
      <button type="submit" class="fl-btn fl-searchpage__submit">{{ 'search.submit' | t }}</button>
    </form>
  </header>

  {%- if search.performed -%}
    {%- assign terms_escaped = search.terms | escape -%}

    {%- if search.results_count == 0 -%}
      <div class="fl-searchpage__empty">
        <p class="fl-searchpage__empty-text">{{ 'search.no_results_html' | t: terms: terms_escaped }}</p>
        <span class="fl-eyebrow">{{ 'search.suggestions' | t }}</span>
        <div class="fl-searchpage__empty-actions">
          <a class="fl-btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
          <a class="fl-btn fl-btn--secondary" href="{{ routes.collections_url }}">{{ 'collections.general.title' | t }}</a>
        </div>
      </div>
    {%- else -%}
      <div class="fl-searchpage__results">
        <p class="fl-searchpage__count">
          {{ 'search.results_for_html' | t: terms: terms_escaped, count: search.results_count }}
        </p>

        {%- paginate search.results by 24 -%}
          {%- liquid
            assign has_products = false
            assign has_other = false
            for result in search.results
              if result.object_type == 'product'
                assign has_products = true
              else
                assign has_other = true
              endif
            endfor
          -%}

          {%- if has_products -%}
            <div class="fl-searchpage__group">
              {%- if has_other -%}
                <span class="fl-eyebrow">{{ 'search.products' | t }}</span>
              {%- endif -%}
              <ul class="fl-product-grid fl-searchpage__grid" role="list">
                {%- comment -%}
                  First row eager: it holds the LCP image on the results page.
                {%- endcomment -%}
                {%- assign product_rank = 0 -%}
                {%- for result in search.results -%}
                  {%- if result.object_type == 'product' -%}
                    {%- assign product_rank = product_rank | plus: 1 -%}
                    <li class="fl-searchpage__cell">
                      {%- if product_rank <= 4 -%}
                        {% render 'product-card', product: result, heading_level: 'h2', loading: 'eager' %}
                      {%- else -%}
                        {% render 'product-card', product: result, heading_level: 'h2' %}
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if has_other -%}
            <div class="fl-searchpage__group">
              <ul class="fl-searchpage__rows" role="list">
                {%- for result in search.results -%}
                  {%- unless result.object_type == 'product' -%}
                    {%- liquid
                      if result.object_type == 'article'
                        assign row_excerpt = result.excerpt_or_content | strip_html | truncatewords: 30
                      else
                        assign row_excerpt = result.content | strip_html | truncatewords: 30
                      endif
                    -%}
                    <li class="fl-searchpage__row">
                      {%- if result.object_type == 'article' -%}
                        <span class="fl-eyebrow fl-searchpage__row-type">{{ 'search.articles' | t }}</span>
                      {%- else -%}
                        <span class="fl-eyebrow fl-searchpage__row-type">{{ 'search.pages' | t }}</span>
                      {%- endif -%}
                      <h2 class="fl-searchpage__row-title">
                        <a class="fl-searchpage__row-link" href="{{ result.url }}">{{ result.title | escape }}</a>
                      </h2>
                      {%- if row_excerpt != blank -%}
                        <p class="fl-searchpage__row-excerpt">{{ row_excerpt }}</p>
                      {%- endif -%}
                    </li>
                  {%- endunless -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            {%- assign current_page_str = paginate.current_page | append: '' -%}
            <nav class="fl-pagination" aria-label="{{ 'general.pagination.label' | t }}">
              {%- if paginate.previous -%}
                <a class="fl-pagination__item" href="{{ paginate.previous.url }}">
                  <span aria-hidden="true">&larr;</span>
                  <span class="visually-hidden">{{ 'general.pagination.previous' | t }}</span>
                </a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a
                    class="fl-pagination__item"
                    href="{{ part.url }}"
                    aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                  >
                    {{- part.title -}}
                  </a>
                {%- elsif part.title == current_page_str -%}
                  <span
                    class="fl-pagination__item"
                    aria-current="page"
                    aria-label="{{ 'general.pagination.current_page' | t: number: part.title }}"
                  >
                    {{- part.title -}}
                  </span>
                {%- else -%}
                  <span class="fl-pagination__gap">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a class="fl-pagination__item" href="{{ paginate.next.url }}">
                  <span aria-hidden="true">&rarr;</span>
                  <span class="visually-hidden">{{ 'general.pagination.next' | t }}</span>
                </a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .fl-searchpage {
    padding-block: 48px 80px;
  }

  .fl-searchpage__head {
    max-width: 680px;
    margin-inline: auto;
    text-align: center;
  }

  .fl-searchpage__form {
    display: flex;
    gap: 12px;
    margin-top: 32px;
  }

  .fl-searchpage__input {
    flex: 1;
    min-width: 0;
    min-height: 56px;
    padding-inline: 20px;
    font-size: calc(var(--font-size-base) * 1.125);
    background: var(--color-surface);
    border-color: transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .fl-searchpage__input:focus-visible {
    background: var(--color-bg);
    border-color: var(--color-ink);
  }

  .fl-searchpage__submit {
    min-height: 56px;
    padding-inline: 28px;
  }

  .fl-searchpage__results {
    margin-top: 36px;
  }

  .fl-searchpage__count {
    margin-bottom: 28px;
    color: var(--color-muted);
  }

  .fl-searchpage__group + .fl-searchpage__group {
    margin-top: 48px;
  }

  .fl-searchpage__group > .fl-eyebrow {
    margin-bottom: 20px;
  }

  .fl-searchpage__grid {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl-searchpage__cell {
    min-width: 0;
  }

  .fl-searchpage__rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl-searchpage__row {
    padding-block: 24px;
    border-top: 1px solid var(--color-line);
  }

  .fl-searchpage__row:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .fl-searchpage__row-type {
    margin-bottom: 6px;
  }

  .fl-searchpage__row-title {
    font-size: 1em;
    font-weight: 500;
  }

  .fl-searchpage__row-link {
    text-decoration: none;
  }

  .fl-searchpage__row-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .fl-searchpage__row-excerpt {
    max-width: 65ch;
    margin-top: 6px;
    font-size: 0.9375em;
    color: var(--color-muted);
  }

  .fl-searchpage__empty {
    max-width: 680px;
    margin-inline: auto;
    margin-top: 36px;
    text-align: center;
  }

  .fl-searchpage__empty .fl-eyebrow {
    margin-top: 36px;
    margin-bottom: 16px;
  }

  .fl-searchpage__empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  a.fl-pagination__item:hover {
    color: var(--color-ink);
    background: var(--color-surface);
  }

  .fl-pagination__item[aria-current='page'] {
    color: var(--color-ink);
    border: 1px solid var(--color-line);
  }

  @media (max-width: 749px) {
    .fl-searchpage__form {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
