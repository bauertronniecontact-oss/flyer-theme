{% comment %}
  Main blog section (blog template).
  Blog title, then a grid of article cards: 16:9 cover image, date,
  linked title and a short excerpt. Token-based pagination, 12 per page.
{% endcomment %}

<div class="fl-blog">
  <header class="fl-blog__head">
    <h1 class="fl-blog__title">{{ blog.title | escape }}</h1>
  </header>

  {%- paginate blog.articles by 12 -%}
    {%- if blog.articles.size == 0 -%}
      <div class="fl-blog__empty">
        <p class="fl-blog__empty-text">{{ 'blog.no_articles' | t }}</p>
      </div>
    {%- else -%}
      <ul class="fl-blog__grid" role="list">
        {%- for article in blog.articles -%}
          {%- liquid
            assign img_loading = 'lazy'
            if forloop.index <= 3
              assign img_loading = 'eager'
            endif
            assign excerpt = article.excerpt_or_content | strip_html | truncatewords: 24
          -%}
          <li class="fl-blog__item">
            <div class="fl-blog__media">
              {%- if article.image -%}
                {{
                  article.image
                  | image_url: width: 1080
                  | image_tag:
                    widths: '360, 540, 720, 1080',
                    sizes: '(max-width: 749px) 100vw, (max-width: 989px) 50vw, 33vw',
                    alt: article.image.alt,
                    loading: img_loading
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'fl-blog__placeholder' }}
              {%- endif -%}
            </div>

            {%- if section.settings.show_date -%}
              <time class="fl-blog__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{- article.published_at | date: format: 'month_day_year' -}}
              </time>
            {%- endif -%}

            <h2 class="fl-blog__post-title">
              <a class="fl-blog__link" href="{{ article.url }}">{{ article.title | escape }}</a>
            </h2>

            {%- if section.settings.show_excerpt and excerpt != blank -%}
              <p class="fl-blog__excerpt">{{ excerpt }}</p>
            {%- endif -%}

            <span class="fl-blog__more" aria-hidden="true">{{ 'blog.read_more' | t }}</span>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        {%- assign current_page_str = paginate.current_page | append: '' -%}
        <nav class="fl-pagination" aria-label="{{ 'general.pagination.label' | t }}">
          {%- if paginate.previous -%}
            <a class="fl-pagination__item" href="{{ paginate.previous.url }}">
              <span aria-hidden="true">&larr;</span>
              <span class="visually-hidden">{{ 'general.pagination.previous' | t }}</span>
            </a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a
                class="fl-pagination__item"
                href="{{ part.url }}"
                aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
              >
                {{- part.title -}}
              </a>
            {%- elsif part.title == current_page_str -%}
              <span
                class="fl-pagination__item"
                aria-current="page"
                aria-label="{{ 'general.pagination.current_page' | t: number: part.title }}"
              >
                {{- part.title -}}
              </span>
            {%- else -%}
              <span class="fl-pagination__gap">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a class="fl-pagination__item" href="{{ paginate.next.url }}">
              <span aria-hidden="true">&rarr;</span>
              <span class="visually-hidden">{{ 'general.pagination.next' | t }}</span>
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .fl-blog {
    padding-block: var(--section-spacing) calc(var(--section-spacing) * 1.5);
  }

  .fl-blog__head {
    max-width: 720px;
    margin-bottom: 48px;
  }

  .fl-blog__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 52px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl-blog__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .fl-blog__media {
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .fl-blog__media img,
  .fl-blog__placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .fl-blog__item:hover .fl-blog__media img {
    transform: scale(1.03);
  }

  .fl-blog__date {
    font-size: 0.8125em;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }

  .fl-blog__post-title {
    font-size: calc(var(--font-size-base) * var(--heading-scale));
    font-weight: 500;
  }

  .fl-blog__link {
    text-decoration: none;
  }

  .fl-blog__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .fl-blog__link:hover {
    text-decoration: underline;
  }

  .fl-blog__excerpt {
    font-size: 0.9375em;
    color: var(--color-muted);
  }

  .fl-blog__more {
    align-self: flex-start;
    margin-top: 2px;
    font-size: 0.875em;
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .fl-blog__item:hover .fl-blog__more {
    color: var(--color-ink);
  }

  .fl-blog__empty {
    padding-block: 72px;
    text-align: center;
  }

  .fl-blog__empty-text {
    color: var(--color-muted);
  }

  .fl-pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: var(--section-spacing);
  }

  .fl-pagination__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 10px;
    color: var(--color-muted);
    text-decoration: none;
    border-radius: var(--radius-btn);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  a.fl-pagination__item:hover {
    color: var(--color-ink);
    background: var(--color-surface);
  }

  .fl-pagination__item[aria-current='page'] {
    color: var(--color-ink);
    border: 1px solid var(--color-line);
  }

  .fl-pagination__gap {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-muted);
  }

  @media (max-width: 989px) {
    .fl-blog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 44px 24px;
    }
  }

  @media (max-width: 749px) {
    .fl-blog__head {
      margin-bottom: 36px;
    }

    .fl-blog__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publication date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    }
  ]
}
{% endschema %}
