{% comment %}
  Slideshow.
  Progressive enhancement: without JS every slide is stacked and fully readable,
  and the controls stay hidden. <fl-slideshow> adds `is-enhanced`, which switches
  the track to a single overlapping cell and reveals arrows / dots / play-pause.
{% endcomment %}

{%- liquid
  assign count = section.blocks.size

  assign show_arrows = false
  if section.settings.show_arrows and count > 1
    assign show_arrows = true
  endif

  assign show_dots = false
  if section.settings.show_dots and count > 1
    assign show_dots = true
  endif

  assign show_toggle = false
  if section.settings.autorotate and count > 1
    assign show_toggle = true
  endif

  assign show_bar = false
  if show_dots or show_toggle
    assign show_bar = true
  endif

  assign ratio = 0
  assign first_image = section.blocks.first.settings.image
  if section.settings.slide_height == 'adapt' and first_image != blank
    assign ratio = first_image.aspect_ratio | round: 4
  endif

  if section.settings.layout == 'full_bleed'
    assign img_sizes = '100vw'
  else
    assign inner_px = settings.max_page_width | minus: 48
    assign img_sizes = '(min-width: ' | append: settings.max_page_width | append: 'px) ' | append: inner_px | append: 'px, 100vw'
  endif

  assign slider_id = 'Slideshow-' | append: section.id
-%}

{%- if count > 0 -%}
  <fl-slideshow
    class="fl-slideshow fl-slideshow--{{ section.settings.slide_height }} color-{{ section.settings.color_scheme }}{% if section.settings.layout == 'full_bleed' %} full-width{% else %} fl-slideshow--boxed{% endif %}"
    role="region"
    aria-label="{{ 'accessibility.carousel' | t }}"
    data-autoplay="{{ section.settings.autorotate }}"
    data-speed="{{ section.settings.autorotate_speed }}"
    style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;{% if ratio > 0 %} --fl-slide-ratio: {{ ratio }};{% endif %}"
  >
    <div class="fl-slideshow__viewport{% if section.settings.layout == 'grid' %} fl-media{% endif %}">
      <div
        class="fl-slideshow__track"
        id="{{ slider_id }}"
        data-track
        aria-live="off"
        aria-atomic="true"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign pos = block.settings.box_align | split: '-'
            assign pos_v = pos | first
            assign pos_h = pos | last

            case pos_v
              when 'top'
                assign justify = 'flex-start'
              when 'bottom'
                assign justify = 'flex-end'
              else
                assign justify = 'center'
            endcase

            case pos_h
              when 'left'
                assign align = 'flex-start'
                assign text_align = 'left'
              when 'right'
                assign align = 'flex-end'
                assign text_align = 'right'
              else
                assign align = 'center'
                assign text_align = 'center'
            endcase

            assign loading = 'lazy'
            assign fetch_priority = 'auto'
            if forloop.first
              assign loading = 'eager'
              assign fetch_priority = 'high'
            endif

            assign show_button = false
            if block.settings.button_label != blank and block.settings.button_link != blank
              assign show_button = true
            endif

            assign has_content = show_button
            if block.settings.heading != blank
              assign has_content = true
            endif
            if block.settings.subheading != blank
              assign has_content = true
            endif
          -%}
          <div
            class="fl-slideshow__slide{% if forloop.first %} is-active{% endif %}"
            data-slide
            {{ block.shopify_attributes }}
          >
            <div class="fl-slideshow__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 3840
                  | image_tag:
                    widths: '750, 1100, 1500, 1920, 2560, 3840',
                    sizes: img_sizes,
                    class: 'fl-slideshow__img',
                    loading: loading,
                    fetchpriority: fetch_priority
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'fl-slideshow__img fl-slideshow__img--ph' }}
              {%- endif -%}
            </div>

            {%- if has_content -%}
              <div
                class="fl-slideshow__content"
                style="justify-content: {{ justify }}; align-items: {{ align }}; text-align: {{ text_align }};"
              >
                <div class="fl-slideshow__box fl-box color-{{ block.settings.color_scheme }}">
                  {%- if block.settings.heading != blank -%}
                    <h2 class="fl-slideshow__heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  {%- if block.settings.subheading != blank -%}
                    <p class="fl-slideshow__text">{{ block.settings.subheading | escape }}</p>
                  {%- endif -%}
                  {%- if show_button -%}
                    <div class="fl-slideshow__cta">
                      <a class="fl-btn" href="{{ block.settings.button_link }}">
                        {{- block.settings.button_label | escape -}}
                      </a>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if show_arrows -%}
        <button
          type="button"
          class="fl-slideshow__arrow fl-slideshow__arrow--prev"
          data-prev
          aria-controls="{{ slider_id }}"
          aria-label="{{ 'accessibility.previous' | t }}"
        >
          <svg class="fl-slideshow__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="fl-slideshow__arrow fl-slideshow__arrow--next"
          data-next
          aria-controls="{{ slider_id }}"
          aria-label="{{ 'accessibility.next' | t }}"
        >
          <svg class="fl-slideshow__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}

      {%- if show_bar -%}
        <div class="fl-slideshow__controls">
          {%- if show_dots -%}
            <div class="fl-slideshow__dots">
              {%- for block in section.blocks -%}
                <button
                  type="button"
                  class="fl-slideshow__dot"
                  data-dot
                  aria-controls="{{ slider_id }}"
                  aria-label="{{ 'accessibility.go_to_slide' | t: index: forloop.index }}"
                  {% if forloop.first %}
                    aria-current="true"
                  {% endif %}
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if show_toggle -%}
            <button
              type="button"
              class="fl-slideshow__toggle"
              data-toggle
              aria-controls="{{ slider_id }}"
              aria-label="{{ 'accessibility.pause_slideshow' | t }}"
              data-label-pause="{{ 'accessibility.pause_slideshow' | t | escape }}"
              data-label-play="{{ 'accessibility.play_slideshow' | t | escape }}"
            >
              <svg
                class="fl-slideshow__icon fl-slideshow__icon--pause"
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"/>
              </svg>
              <svg
                class="fl-slideshow__icon fl-slideshow__icon--play"
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M8 5.5 18 12 8 18.5z" fill="currentColor"/>
              </svg>
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </fl-slideshow>
{%- endif -%}

{% stylesheet %}
  .fl-slideshow {
    display: block;
    position: relative;
  }

  .fl-slideshow__viewport {
    position: relative;
    overflow: hidden;
    min-width: 0;
  }

  /* No-JS default: slides sit in normal flow, one under the other. */
  .fl-slideshow__slide {
    position: relative;
    display: flex;
    overflow: hidden;
    min-width: 0;
    background-color: var(--color-surface);
  }

  .fl-slideshow.is-enhanced .fl-slideshow__track {
    display: grid;
  }

  .fl-slideshow.is-enhanced .fl-slideshow__slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease,
      visibility 0s linear 0.5s;
  }

  .fl-slideshow.is-enhanced .fl-slideshow__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s ease;
  }

  /* Heights */
  .fl-slideshow--small .fl-slideshow__slide {
    min-height: 40vh;
    min-height: 40svh;
  }

  .fl-slideshow--medium .fl-slideshow__slide {
    min-height: 60vh;
    min-height: 60svh;
  }

  .fl-slideshow--large .fl-slideshow__slide {
    min-height: 80vh;
    min-height: 80svh;
  }

  .fl-slideshow--adapt .fl-slideshow__slide {
    aspect-ratio: var(--fl-slide-ratio, 16 / 9);
    min-height: 320px;
  }

  .fl-slideshow__media {
    position: absolute;
    inset: 0;
    min-width: 0;
  }

  .fl-slideshow__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fl-slideshow__img--ph {
    fill: var(--color-muted);
    opacity: 0.35;
  }

  .fl-slideshow__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding: clamp(24px, 5vw, 56px) var(--page-margin);
  }

  .fl-slideshow--boxed .fl-slideshow__content {
    max-width: none;
    padding-inline: clamp(20px, 4vw, 48px);
  }

  .fl-slideshow__box {
    width: min(520px, 100%);
    padding: clamp(20px, 3.5vw, 36px);
  }

  .fl-slideshow__heading {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  .fl-slideshow__heading + .fl-slideshow__text {
    margin-top: 12px;
  }

  .fl-slideshow__text {
    color: var(--color-muted);
  }

  .fl-slideshow__cta {
    margin-top: 24px;
  }

  /* Controls — revealed only once the custom element has upgraded. */
  .fl-slideshow__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: var(--color-ink);
    background-color: rgba(var(--color-bg-rgb), 0.85);
    border: 1px solid var(--color-line);
    border-radius: 50%;
    cursor: pointer;
    transform: translateY(-50%);
    transition: background-color 0.15s ease;
  }

  .fl-slideshow.is-enhanced .fl-slideshow__arrow {
    display: inline-flex;
  }

  .fl-slideshow__arrow:hover {
    background-color: var(--color-bg);
  }

  .fl-slideshow__arrow--prev {
    left: 12px;
  }

  .fl-slideshow__arrow--next {
    right: 12px;
  }

  .fl-slideshow__icon {
    width: 18px;
    height: 18px;
  }

  .fl-slideshow__controls {
    position: absolute;
    bottom: 12px;
    left: 50%;
    z-index: 2;
    display: none;
    align-items: center;
    max-width: calc(100% - 24px);
    padding-inline: 4px;
    background-color: rgba(var(--color-bg-rgb), 0.85);
    border-radius: 40px;
    transform: translateX(-50%);
  }

  .fl-slideshow.is-enhanced .fl-slideshow__controls {
    display: flex;
  }

  .fl-slideshow__dots {
    display: flex;
    align-items: center;
  }

  .fl-slideshow__dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: var(--color-ink);
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .fl-slideshow__dot::before {
    content: '';
    width: 8px;
    height: 8px;
    background-color: currentcolor;
    border-radius: 50%;
    opacity: 0.35;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .fl-slideshow__dot[aria-current='true']::before {
    opacity: 1;
    transform: scale(1.3);
  }

  .fl-slideshow__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: var(--color-ink);
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .fl-slideshow__icon--play {
    display: none;
  }

  .fl-slideshow__toggle.is-paused .fl-slideshow__icon--play {
    display: block;
  }

  .fl-slideshow__toggle.is-paused .fl-slideshow__icon--pause {
    display: none;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('fl-slideshow')) {
    customElements.define(
      'fl-slideshow',
      class extends HTMLElement {
        connectedCallback() {
          this.slides = Array.from(this.querySelectorAll('[data-slide]'));
          if (this.slides.length === 0) return;

          this.track = this.querySelector('[data-track]');
          this.dots = Array.from(this.querySelectorAll('[data-dot]'));
          this.toggle = this.querySelector('[data-toggle]');
          this.index = 0;
          this.timer = null;
          this.paused = false;

          this.classList.add('is-enhanced');
          this.show(0);
          if (this.slides.length < 2) return;

          this.delay = 5000;
          const seconds = parseInt(this.dataset.speed, 10);
          if (seconds > 0) this.delay = seconds * 1000;
          this.autoplay = this.dataset.autoplay === 'true';

          this.motion = window.matchMedia('(prefers-reduced-motion: reduce)');
          this.onMotionChange = () => {
            if (this.motion.matches) {
              this.stop();
            } else {
              this.start();
            }
            this.syncToggle();
          };
          this.motion.addEventListener('change', this.onMotionChange);

          const prev = this.querySelector('[data-prev]');
          const next = this.querySelector('[data-next]');
          if (prev) prev.addEventListener('click', () => this.step(-1));
          if (next) next.addEventListener('click', () => this.step(1));

          this.dots.forEach((dot, i) => {
            dot.addEventListener('click', () => this.step(i - this.index));
          });

          if (this.toggle) {
            this.toggle.addEventListener('click', () => {
              this.paused = !this.paused;
              if (this.paused) {
                this.stop();
              } else {
                this.start();
              }
              this.syncToggle();
            });
          }

          this.onKeydown = (event) => {
            if (event.key === 'ArrowLeft') {
              event.preventDefault();
              this.step(-1);
            } else if (event.key === 'ArrowRight') {
              event.preventDefault();
              this.step(1);
            }
          };
          this.addEventListener('keydown', this.onKeydown);

          this.addEventListener('mouseenter', () => this.stop());
          this.addEventListener('mouseleave', () => {
            if (!this.contains(document.activeElement)) this.start();
          });
          this.addEventListener('focusin', () => this.stop());
          this.addEventListener('focusout', (event) => {
            if (!this.contains(event.relatedTarget)) this.start();
          });

          if (window.Shopify && window.Shopify.designMode) {
            this.onBlockSelect = (event) => {
              const i = this.slides.indexOf(event.target);
              if (i > -1) {
                this.paused = true;
                this.stop();
                this.show(i);
                this.syncToggle();
              }
            };
            this.onBlockDeselect = (event) => {
              if (this.slides.indexOf(event.target) > -1) {
                this.paused = false;
                this.start();
                this.syncToggle();
              }
            };
            document.addEventListener('shopify:block:select', this.onBlockSelect);
            document.addEventListener('shopify:block:deselect', this.onBlockDeselect);
          }

          this.start();
          this.syncToggle();
        }

        disconnectedCallback() {
          this.stopTimer();
          if (this.motion && this.onMotionChange) {
            this.motion.removeEventListener('change', this.onMotionChange);
          }
          if (this.onKeydown) this.removeEventListener('keydown', this.onKeydown);
          if (this.onBlockSelect) document.removeEventListener('shopify:block:select', this.onBlockSelect);
          if (this.onBlockDeselect) document.removeEventListener('shopify:block:deselect', this.onBlockDeselect);
        }

        show(i) {
          const total = this.slides.length;
          this.index = ((i % total) + total) % total;
          this.slides.forEach((slide, j) => slide.classList.toggle('is-active', j === this.index));
          this.dots.forEach((dot, j) => {
            if (j === this.index) {
              dot.setAttribute('aria-current', 'true');
            } else {
              dot.removeAttribute('aria-current');
            }
          });
        }

        step(delta) {
          if (this.track) this.track.setAttribute('aria-live', 'polite');
          this.show(this.index + delta);
          this.restart();
        }

        start() {
          if (!this.autoplay) return;
          if (this.paused) return;
          if (this.motion.matches) return;
          this.stopTimer();
          if (this.track) this.track.setAttribute('aria-live', 'off');
          this.timer = setInterval(() => this.show(this.index + 1), this.delay);
        }

        restart() {
          if (!this.timer) return;
          this.stopTimer();
          this.timer = setInterval(() => this.show(this.index + 1), this.delay);
        }

        stop() {
          this.stopTimer();
          if (this.track) this.track.setAttribute('aria-live', 'polite');
        }

        stopTimer() {
          if (this.timer) clearInterval(this.timer);
          this.timer = null;
        }

        syncToggle() {
          if (!this.toggle) return;
          const isPaused = this.paused || this.motion.matches;
          this.toggle.classList.toggle('is-paused', isPaused);
          const label = isPaused ? this.toggle.dataset.labelPlay : this.toggle.dataset.labelPause;
          if (label) this.toggle.setAttribute('aria-label', label);
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Slideshow",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "full_bleed",
          "label": "Full width"
        },
        {
          "value": "grid",
          "label": "Inside page margins"
        }
      ],
      "default": "full_bleed"
    },
    {
      "type": "select",
      "id": "slide_height",
      "label": "Slide height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to first image"
        },
        {
          "value": "small",
          "label": "Small (40% of screen)"
        },
        {
          "value": "medium",
          "label": "Medium (60% of screen)"
        },
        {
          "value": "large",
          "label": "Large (80% of screen)"
        }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "autorotate",
      "label": "Rotate slides automatically",
      "default": false
    },
    {
      "type": "range",
      "id": "autorotate_speed",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "New season essentials"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Tell your brand’s story in a sentence or two."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now",
          "info": "Both the label and the link are needed to show the button."
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "box_align",
          "label": "Text position",
          "options": [
            {
              "value": "top-left",
              "label": "Top left"
            },
            {
              "value": "top-center",
              "label": "Top center"
            },
            {
              "value": "top-right",
              "label": "Top right"
            },
            {
              "value": "middle-left",
              "label": "Middle left"
            },
            {
              "value": "middle-center",
              "label": "Middle center"
            },
            {
              "value": "middle-right",
              "label": "Middle right"
            },
            {
              "value": "bottom-left",
              "label": "Bottom left"
            },
            {
              "value": "bottom-center",
              "label": "Bottom center"
            },
            {
              "value": "bottom-right",
              "label": "Bottom right"
            }
          ],
          "default": "middle-left"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Text box colour scheme",
          "default": "scheme-1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "settings": {
        "padding_top": 0,
        "padding_bottom": 0
      },
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide",
          "settings": {
            "heading": "Made to be worn often",
            "box_align": "middle-right"
          }
        }
      ]
    }
  ]
}
{% endschema %}
