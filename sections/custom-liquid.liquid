<div
  class="fl-custom-liquid color-{{ section.settings.color_scheme }}"
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  {{ section.settings.custom_liquid }}
</div>

{% stylesheet %}
  .fl-custom-liquid {
    min-width: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Liquid",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid",
      "info": "Add app snippets or other Liquid code."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Custom Liquid"
    }
  ]
}
{% endschema %}
