{% comment %}
  FLYER — 404 (templates/404.json).
{% endcomment %}

<div class="fl-404">
  <h1 class="fl-404__title">{{ '404.title' | t }}</h1>
  <p class="fl-404__text">{{ '404.subtext' | t }}</p>
  <a class="fl-btn" href="{{ routes.root_url }}">{{ '404.back_to_shopping' | t }}</a>
</div>

{% stylesheet %}
  .fl-404 {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 50vh;
    padding-block: 80px;
    text-align: center;
  }

  .fl-404__title {
    margin: 0;
  }

  .fl-404__text {
    margin-bottom: 12px;
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "settings": []
}
{% endschema %}
