{% comment %}
  FLYER — Page (templates/page.json).
{% endcomment %}

<div class="fl-page">
  <h1 class="fl-page__title">{{ page.title | escape }}</h1>

  {%- if page.content != blank -%}
    <div class="fl-page__content fl-rte">{{ page.content }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .fl-page {
    width: min(720px, 100%);
    margin-inline: auto;
    padding-block: 48px 80px;
  }

  .fl-page__title {
    margin-bottom: 32px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "settings": []
}
{% endschema %}
