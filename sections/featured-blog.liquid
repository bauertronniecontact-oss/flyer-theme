{% comment %}
  Featured blog.
  Row header (heading + optional “View all” link) above a grid of article cards
  built from the Blog cards theme settings (--blog-card-* tokens and, in “Card”
  style, settings.blog_card_color_scheme). Falls back to placeholder cards when
  no blog is selected so the section previews in the editor.
{% endcomment %}

{%- liquid
  assign feat_blog = section.settings.blog
  assign limit = section.settings.post_limit
  assign cols = section.settings.columns_desktop
  assign heading = section.settings.heading

  comment
    Card titles sit under the section heading. With no heading rendered there is
    no h2 above them, so they take that level themselves instead of skipping it.
  endcomment
  assign title_tag = 'h3'
  if heading == blank
    assign title_tag = 'h2'
  endif

  assign cols_tablet = 2
  if cols == 1
    assign cols_tablet = 1
  endif

  assign show_link = false
  if section.settings.show_view_all and feat_blog != blank and feat_blog.articles_count > limit
    assign show_link = true
  endif

  assign boxed = false
  if settings.blog_card_style == 'card'
    assign boxed = true
  endif

  case cols
    when 1
      assign sizes_desktop = '100vw'
    when 2
      assign sizes_desktop = '50vw'
    when 3
      assign sizes_desktop = '33vw'
    else
      assign sizes_desktop = '25vw'
  endcase
  assign card_sizes = '(max-width: 749px) 100vw, (max-width: 989px) 50vw, ' | append: sizes_desktop
-%}

<section
  class="fl-featblog full-width color-{{ section.settings.color_scheme }}"
  {% render 'reveal' %}
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px"
>
  <div class="fl-featblog__inner">
    {%- if heading != blank or show_link -%}
      <div class="fl-featblog__head">
        {%- if heading != blank -%}
          <h2 class="fl-featblog__heading">{{ heading | escape }}</h2>
        {%- endif -%}
        {%- if show_link -%}
          <a class="fl-featblog__viewall" href="{{ feat_blog.url }}">
            {{- 'collections.general.view_all' | t -}}
            <span class="visually-hidden"> {{ feat_blog.title | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="fl-featblog__grid"
      role="list"
      style="--featblog-cols: {{ cols }}; --featblog-cols-tablet: {{ cols_tablet }}"
    >
      {%- if feat_blog.articles_count > 0 -%}
        {%- for article in feat_blog.articles limit: limit -%}
          {%- liquid
            assign excerpt = article.excerpt_or_content | strip_html | truncatewords: 20

            assign meta_date = ''
            if section.settings.show_date
              assign meta_date = article.published_at | date: format: 'month_day_year'
            endif

            assign meta_author = ''
            if section.settings.show_author
              assign meta_author = article.author
            endif
          -%}
          <li class="fl-featblog__item">
            <article
              class="fl-featblog__card{% if boxed %} fl-featblog__card--boxed color-{{ settings.blog_card_color_scheme }}{% endif %}"
            >
              {%- if section.settings.show_image -%}
                <div class="fl-featblog__media">
                  {%- if article.image -%}
                    {{
                      article.image
                      | image_url: width: 1080
                      | image_tag:
                        widths: '360, 540, 720, 1080',
                        sizes: card_sizes,
                        alt: article.image.alt,
                        loading: 'lazy',
                        class: 'fl-featblog__img'
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'fl-featblog__ph' }}
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="fl-featblog__body">
                {%- if meta_date != blank or meta_author != blank -%}
                  <p class="fl-featblog__meta">
                    {%- if meta_date != blank -%}
                      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ meta_date }}</time>
                    {%- endif -%}
                    {%- if meta_date != blank and meta_author != blank -%}
                      <span aria-hidden="true"> — </span>
                    {%- endif -%}
                    {%- if meta_author != blank -%}
                      <span>{{ meta_author | escape }}</span>
                    {%- endif -%}
                  </p>
                {%- endif -%}

                <{{ title_tag }} class="fl-featblog__title">
                  <a class="fl-featblog__link" href="{{ article.url }}">{{ article.title | escape }}</a>
                </{{ title_tag }}>

                {%- if excerpt != blank -%}
                  <p class="fl-featblog__excerpt">{{ excerpt }}</p>
                {%- endif -%}

                <span class="fl-featblog__more" aria-hidden="true">{{ 'blog.read_more' | t }}</span>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}
          Also covers a chosen but empty blog, which used to render a heading
          with nothing under it.
        {%- endcomment -%}
        {%- for i in (1..limit) -%}
          <li class="fl-featblog__item">
            <article
              class="fl-featblog__card{% if boxed %} fl-featblog__card--boxed color-{{ settings.blog_card_color_scheme }}{% endif %}"
            >
              {%- if section.settings.show_image -%}
                <div class="fl-featblog__media">
                  {{ 'image' | placeholder_svg_tag: 'fl-featblog__ph' }}
                </div>
              {%- endif -%}
              <div class="fl-featblog__body">
                <{{ title_tag }} class="fl-featblog__title">
                  {{- 'blog.placeholder_title' | t -}}
                </{{ title_tag }}>
                <span class="fl-featblog__more" aria-hidden="true">{{ 'blog.read_more' | t }}</span>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .fl-featblog {
    display: block;
  }

  .fl-featblog__inner {
    width: var(--content-width);
    margin-inline: auto;
  }

  .fl-featblog__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 24px;
    margin-block-end: 28px;
  }

  .fl-featblog__heading {
    min-width: 0;
  }

  .fl-featblog__viewall {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875em;
    white-space: nowrap;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }

  .fl-featblog__viewall:hover {
    color: var(--color-ink);
  }

  .fl-featblog__grid {
    display: grid;
    grid-template-columns: repeat(var(--featblog-cols, 3), minmax(0, 1fr));
    gap: var(--grid-gap-y, 28px) var(--grid-gap-x, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl-featblog__item {
    display: flex;
    min-width: 0;
  }

  .fl-featblog__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    min-width: 0;
    text-align: var(--blog-card-text-align, left);
    border: var(--blog-card-border-width, 0) solid
      rgba(var(--color-ink-rgb), var(--blog-card-border-opacity, 0.1));
    border-radius: var(--blog-card-radius, 8px);
    box-shadow: var(--blog-card-shadow);
  }

  /* “Card” style wraps the whole tile in the blog card colour scheme. */
  .fl-featblog__card--boxed {
    padding: var(--blog-card-image-padding, 0);
    background: var(--color-bg);
  }

  .fl-featblog__media {
    min-width: 0;
    overflow: hidden;
    border-radius: var(--blog-card-radius, 8px);
    background: var(--color-surface);
  }

  .fl-featblog__img,
  .fl-featblog__ph {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  /* Shopify placeholder SVGs inherit `fill`, which defaults to solid black. */
  .fl-featblog__ph {
    fill: var(--color-muted);
    opacity: 0.35;
  }

  .fl-featblog__card:hover .fl-featblog__img {
    transform: scale(1.03);
  }

  .fl-featblog__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .fl-featblog__card--boxed .fl-featblog__body {
    padding: 16px;
  }

  .fl-featblog__meta {
    font-size: 0.8125em;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }

  .fl-featblog__title {
    font-size: calc(var(--font-size-base) * var(--heading-scale));
    font-weight: 500;
  }

  .fl-featblog__link {
    text-decoration: none;
  }

  .fl-featblog__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .fl-featblog__link:hover {
    text-decoration: underline;
  }

  .fl-featblog__excerpt {
    font-size: 0.9375em;
    color: var(--color-muted);
  }

  .fl-featblog__more {
    margin-top: 2px;
    font-size: 0.875em;
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .fl-featblog__card:hover .fl-featblog__more {
    color: var(--color-ink);
  }

  @media (max-width: 989px) {
    .fl-featblog__grid {
      grid-template-columns: repeat(var(--featblog-cols-tablet, 2), minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .fl-featblog__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .fl-featblog__head {
      margin-block-end: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured blog",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Posts to show",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publication date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show “View all” link",
      "info": "Shown when the blog has more posts than the section displays.",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Featured blog"
    }
  ]
}
{% endschema %}
