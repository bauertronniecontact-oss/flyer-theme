{% comment %}
  Related products (product template).
  <fl-related> lazily fetches Shopify recommendations via the Section
  Rendering API (routes.product_recommendations_url) when the section nears
  the viewport, then swaps in the returned grid. Renders nothing until the
  API responds, and stays hidden when there are no recommendations.
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'products.related.heading' | t
  endif
-%}

<fl-related
  class="fl-related"
  {% if product %}
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent={{ section.settings.intent | default: 'related' }}"
  {% endif %}
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div
      class="fl-related__inner"
      style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px"
    >
      <div class="fl-section-head">
        <h2>{{ heading | escape }}</h2>
      </div>
      <div class="fl-product-grid" style="--grid-cols: 4; --grid-cols-tablet: 3; --grid-cols-mobile: 2">
        {%- for rec in recommendations.products -%}
          {% render 'product-card', product: rec %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</fl-related>

{% stylesheet %}
  .fl-related {
    display: block;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('fl-related')) {
    customElements.define(
      'fl-related',
      class extends HTMLElement {
        connectedCallback() {
          if (this.dataset.loaded) return;
          const url = this.dataset.url;
          if (!url) return;
          const load = () => {
            if (this.dataset.loaded) return;
            this.dataset.loaded = 'true';
            fetch(url)
              .then((response) => {
                if (!response.ok) throw new Error(String(response.status));
                return response.text();
              })
              .then((text) => {
                const doc = new DOMParser().parseFromString(text, 'text/html');
                const fresh = doc.querySelector('fl-related');
                if (fresh && fresh.innerHTML.trim().length) {
                  this.innerHTML = fresh.innerHTML;
                }
              })
              .catch(() => {});
          };
          if ('IntersectionObserver' in window) {
            this.observer = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    this.observer.disconnect();
                    load();
                  }
                });
              },
              { rootMargin: '400px 0px' }
            );
            this.observer.observe(this);
          } else {
            load();
          }
        }

        disconnectedCallback() {
          if (this.observer) this.observer.disconnect();
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "info": "Complementary products are the ones you pair by hand in the free Shopify Search & Discovery app. Add this section a second time to show both.",
      "options": [
        {
          "value": "related",
          "label": "Related products (automatic)"
        },
        {
          "value": "complementary",
          "label": "Complementary products (Search & Discovery)"
        }
      ],
      "default": "related"
    },
    {
      "type": "paragraph",
      "content": "Automatic recommendations based on the current product. Use on the product template."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the default heading."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [
    { "name": "Related products" },
    { "name": "Complementary products", "settings": { "intent": "complementary", "heading": "Goes well with" } }
  ]
}
{% endschema %}
