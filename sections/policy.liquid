{% comment %}
  FLYER — Store policy (templates/policy.json): refund, privacy, terms, shipping.
{% endcomment %}

<div class="fl-policy">
  <h1 class="fl-policy__title">{{ policy.title | escape }}</h1>
  <div class="fl-policy__body fl-rte">{{ policy.body }}</div>
</div>

{% stylesheet %}
  .fl-policy {
    width: min(720px, 100%);
    margin-inline: auto;
    padding-block: 48px 80px;
  }

  .fl-policy__title {
    margin-bottom: 32px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Policy",
  "tag": "section",
  "settings": []
}
{% endschema %}
