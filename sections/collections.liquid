{% comment %}
  FLYER — Collections list (templates/list-collections.json).
{% endcomment %}

<div
  class="fl-collections"
  style="--grid-cols: {{ section.settings.columns_desktop }}; --grid-cols-mobile: {{ section.settings.columns_mobile }};"
>
  <h1 class="fl-collections__title">{{ 'collections.general.title' | t }}</h1>

  {%- paginate collections by 24 -%}
    <ul class="fl-collections__grid" role="list">
      {%- for collection in collections -%}
        <li class="fl-collections__item">
          <a class="fl-collections__link" href="{{ collection.url }}">
            <span class="fl-collections__media">
              {%- if collection.featured_image -%}
                {{
                  collection.featured_image
                  | image_url: width: 900
                  | image_tag: widths: '300, 450, 600, 900', sizes: '(max-width: 749px) 50vw, 33vw', alt: collection.featured_image.alt, loading: 'lazy'
                }}
              {%- elsif collection.products.first.featured_image -%}
                {{
                  collection.products.first.featured_image
                  | image_url: width: 900
                  | image_tag: widths: '300, 450, 600, 900', sizes: '(max-width: 749px) 50vw, 33vw', alt: collection.title, loading: 'lazy'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'fl-collections__placeholder' }}
              {%- endif -%}
            </span>

            <span class="fl-collections__info">
              <span class="fl-collections__name">{{ collection.title | escape }}</span>
              {%- if section.settings.show_count -%}
                <span class="fl-collections__count">
                  {{- 'collections.general.product_count' | t: count: collection.products_count -}}
                </span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if paginate.pages > 1 -%}
      <nav class="fl-collections__pagination" aria-label="{{ 'general.pagination.label' | t }}">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>
        {%- endif -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .fl-collections {
    padding-block: 48px 80px;
  }

  .fl-collections__title {
    margin-bottom: 32px;
  }

  .fl-collections__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols, 3), minmax(0, 1fr));
    gap: 32px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (max-width: 749px) {
    .fl-collections__grid {
      grid-template-columns: repeat(var(--grid-cols-mobile, 2), minmax(0, 1fr));
      gap: 24px 12px;
    }
  }

  .fl-collections__item {
    min-width: 0;
  }

  .fl-collections__link {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
  }

  .fl-collections__media {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .fl-collections__media img,
  .fl-collections__placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .fl-collections__link:hover .fl-collections__media img {
    transform: scale(1.03);
  }

  .fl-collections__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .fl-collections__name {
    font-weight: 500;
  }

  .fl-collections__count {
    font-size: 0.875em;
    color: var(--color-muted);
  }

  .fl-collections__pagination {
    display: flex;
    gap: 20px;
    margin-top: 40px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": false
    }
  ]
}
{% endschema %}
