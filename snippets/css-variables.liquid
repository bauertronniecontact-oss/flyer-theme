{% comment %}
  Emits every design token.

  Colour schemes work like Dawn's: each scheme becomes a `.color-<id>` class
  that re-points the same token names FLYER already uses, so any section can
  opt into a palette just by carrying that class. The first scheme is also
  applied to :root as the page default.

  Surface / line / muted / control-border are derived from each scheme's own
  background and text so a merchant only picks the colours that matter.
{% endcomment %}

{% style %}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}

  {% for scheme in settings.color_schemes -%}
    {%- liquid
      assign bg = scheme.settings.background
      assign ink = scheme.settings.text
      assign surface = bg | color_mix: ink, 96
      assign line = bg | color_mix: ink, 88
      # Weights are contrast floors, not taste: 70% keeps secondary text above
      # 4.5:1 and 58% keeps control borders above 3:1 on every shipped scheme,
      # including the light-warm one where lower weights failed.
      assign muted = ink | color_mix: bg, 70
      assign control_border = ink | color_mix: bg, 58
    -%}
    {% if forloop.first %}:root,{% endif %}
    .color-{{ scheme.id }} {
      --color-bg: {{ bg }};
      --color-bg-rgb: {{ bg.red }}, {{ bg.green }}, {{ bg.blue }};
      {% if scheme.settings.background_gradient != empty %}
        --gradient-bg: {{ scheme.settings.background_gradient }};
      {% else %}
        --gradient-bg: {{ bg }};
      {% endif %}
      --color-ink: {{ ink }};
      --color-ink-rgb: {{ ink.red }}, {{ ink.green }}, {{ ink.blue }};
      --color-surface: {{ surface }};
      --color-line: {{ line }};
      --color-muted: {{ muted }};
      --color-control-border: {{ control_border }};
      --color-accent: {{ scheme.settings.button }};
      --color-accent-rgb: {{ scheme.settings.button.red }}, {{ scheme.settings.button.green }}, {{ scheme.settings.button.blue }};
      --color-on-accent: {{ scheme.settings.button_label }};
      --color-outline-label: {{ scheme.settings.secondary_button_label }};
      --color-outline-label-rgb: {{ scheme.settings.secondary_button_label.red }}, {{ scheme.settings.secondary_button_label.green }}, {{ scheme.settings.secondary_button_label.blue }};
      --color-shadow-rgb: {{ scheme.settings.shadow.red }}, {{ scheme.settings.shadow.green }}, {{ scheme.settings.shadow.blue }};
    }
  {% endfor %}

  {% comment %}
    Shadows are emitted per scheme, not in :root. A custom property is
    substituted where it is DECLARED, so composing rgba(var(--color-shadow-rgb))
    at :root baked the first scheme's shadow colour into every other scheme.
  {% endcomment %}
  {% for scheme in settings.color_schemes %}
    {% if forloop.first %}:root,{% endif %}
    .color-{{ scheme.id }} {
      --btn-shadow: {{ settings.buttons_shadow_horizontal_offset }}px {{ settings.buttons_shadow_vertical_offset }}px {{ settings.buttons_shadow_blur }}px rgba({{ scheme.settings.shadow.red }}, {{ scheme.settings.shadow.green }}, {{ scheme.settings.shadow.blue }}, {{ settings.buttons_shadow_opacity | divided_by: 100.0 }});
      --input-shadow: {{ settings.inputs_shadow_horizontal_offset }}px {{ settings.inputs_shadow_vertical_offset }}px {{ settings.inputs_shadow_blur }}px rgba({{ scheme.settings.shadow.red }}, {{ scheme.settings.shadow.green }}, {{ scheme.settings.shadow.blue }}, {{ settings.inputs_shadow_opacity | divided_by: 100.0 }});
      --pill-shadow: {{ settings.variant_pills_shadow_horizontal_offset }}px {{ settings.variant_pills_shadow_vertical_offset }}px {{ settings.variant_pills_shadow_blur }}px rgba({{ scheme.settings.shadow.red }}, {{ scheme.settings.shadow.green }}, {{ scheme.settings.shadow.blue }}, {{ settings.variant_pills_shadow_opacity | divided_by: 100.0 }});
      --card-shadow: {{ settings.card_shadow_horizontal_offset }}px {{ settings.card_shadow_vertical_offset }}px {{ settings.card_shadow_blur }}px rgba({{ scheme.settings.shadow.red }}, {{ scheme.settings.shadow.green }}, {{ scheme.settings.shadow.blue }}, {{ settings.card_shadow_opacity | divided_by: 100.0 }});
      --coll-card-shadow: {{ settings.collection_card_shadow_horizontal_offset }}px {{ settings.collection_card_shadow_vertical_offset }}px {{ settings.collection_card_shadow_blur }}px rgba({{ scheme.settings.shadow.red }}, {{ scheme.settings.shadow.green }}, {{ scheme.settings.shadow.blue }}, {{ settings.collection_card_shadow_opacity | divided_by: 100.0 }});
      --blog-card-shadow: {{ settings.blog_card_shadow_horizontal_offset }}px {{ settings.blog_card_shadow_vertical_offset }}px {{ settings.blog_card_shadow_blur }}px rgba({{ scheme.settings.shadow.red }}, {{ scheme.settings.shadow.green }}, {{ scheme.settings.shadow.blue }}, {{ settings.blog_card_shadow_opacity | divided_by: 100.0 }});
      --box-shadow: {{ settings.text_boxes_shadow_horizontal_offset }}px {{ settings.text_boxes_shadow_vertical_offset }}px {{ settings.text_boxes_shadow_blur }}px rgba({{ scheme.settings.shadow.red }}, {{ scheme.settings.shadow.green }}, {{ scheme.settings.shadow.blue }}, {{ settings.text_boxes_shadow_opacity | divided_by: 100.0 }});
      --media-shadow: {{ settings.media_shadow_horizontal_offset }}px {{ settings.media_shadow_vertical_offset }}px {{ settings.media_shadow_blur }}px rgba({{ scheme.settings.shadow.red }}, {{ scheme.settings.shadow.green }}, {{ scheme.settings.shadow.blue }}, {{ settings.media_shadow_opacity | divided_by: 100.0 }});
      --popup-shadow: {{ settings.popup_shadow_horizontal_offset }}px {{ settings.popup_shadow_vertical_offset }}px {{ settings.popup_shadow_blur }}px rgba({{ scheme.settings.shadow.red }}, {{ scheme.settings.shadow.green }}, {{ scheme.settings.shadow.blue }}, {{ settings.popup_shadow_opacity | divided_by: 100.0 }});
      --drawer-shadow: {{ settings.drawer_shadow_horizontal_offset }}px {{ settings.drawer_shadow_vertical_offset }}px {{ settings.drawer_shadow_blur }}px rgba({{ scheme.settings.shadow.red }}, {{ scheme.settings.shadow.green }}, {{ scheme.settings.shadow.blue }}, {{ settings.drawer_shadow_opacity | divided_by: 100.0 }});
    }

    .color-{{ scheme.id }} {
      color: var(--color-ink);
      background: var(--gradient-bg);
    }
  {% endfor %}

  :root {
    /* Typography */
    --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body-style: {{ settings.type_body_font.style }};
    --font-body-weight: {{ settings.type_body_font.weight }};
    --font-heading-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading-style: {{ settings.type_heading_font.style }};
    --font-heading-weight: {{ settings.type_heading_font.weight }};
    --font-size-base: {{ settings.type_base_size }}px;
    --body-scale: {{ settings.type_body_scale | divided_by: 100.0 }};
    --heading-scale: {{ settings.type_heading_scale | divided_by: 100.0 }};
    --heading-case: {{ settings.type_heading_case }};

    /* Layout */
    --page-width: {{ settings.max_page_width }}px;
    --page-margin: {{ settings.min_page_margin }}px;
    --section-spacing: {{ settings.section_spacing }}px;
    --grid-gap-x: {{ settings.spacing_grid_horizontal }}px;
    --grid-gap-y: {{ settings.spacing_grid_vertical }}px;

    /* Buttons */
    --radius-btn: {{ settings.radius_buttons }}px;
    --btn-border-width: {{ settings.buttons_border_thickness }}px;
    --btn-border-opacity: {{ settings.buttons_border_opacity | divided_by: 100.0 }};

    /* Inputs */
    --radius-input: {{ settings.radius_inputs }}px;
    --input-border-width: {{ settings.inputs_border_thickness }}px;
    --input-border-opacity: {{ settings.inputs_border_opacity | divided_by: 100.0 }};

    /* Variant pills */
    --pill-radius: {{ settings.variant_pills_radius }}px;
    --pill-border-width: {{ settings.variant_pills_border_thickness }}px;
    --pill-border-opacity: {{ settings.variant_pills_border_opacity | divided_by: 100.0 }};

    /* Product cards */
    --radius-card: {{ settings.radius_cards }}px;
    --card-border-width: {{ settings.card_border_thickness }}px;
    --card-border-opacity: {{ settings.card_border_opacity | divided_by: 100.0 }};
    --card-image-padding: {{ settings.card_image_padding }}px;
    --card-text-align: {{ settings.card_text_alignment }};
    {% case settings.card_image_ratio %}
      {% when 'square' %}
        --card-ratio: 1 / 1;
      {% when 'portrait' %}
        --card-ratio: 4 / 5;
      {% else %}
        --card-ratio: auto;
    {% endcase %}

    /* Collection cards */
    --coll-card-radius: {{ settings.collection_card_corner_radius }}px;
    --coll-card-border-width: {{ settings.collection_card_border_thickness }}px;
    --coll-card-border-opacity: {{ settings.collection_card_border_opacity | divided_by: 100.0 }};
    --coll-card-image-padding: {{ settings.collection_card_image_padding }}px;
    --coll-card-text-align: {{ settings.collection_card_text_alignment }};

    /* Blog cards */
    --blog-card-radius: {{ settings.blog_card_corner_radius }}px;
    --blog-card-border-width: {{ settings.blog_card_border_thickness }}px;
    --blog-card-border-opacity: {{ settings.blog_card_border_opacity | divided_by: 100.0 }};
    --blog-card-image-padding: {{ settings.blog_card_image_padding }}px;
    --blog-card-text-align: {{ settings.blog_card_text_alignment }};

    /* Content containers */
    --box-radius: {{ settings.text_boxes_radius }}px;
    --box-border-width: {{ settings.text_boxes_border_thickness }}px;
    --box-border-opacity: {{ settings.text_boxes_border_opacity | divided_by: 100.0 }};

    /* Media */
    --media-radius: {{ settings.media_radius }}px;
    --media-border-width: {{ settings.media_border_thickness }}px;
    --media-border-opacity: {{ settings.media_border_opacity | divided_by: 100.0 }};

    /* Popups */
    --popup-radius: {{ settings.popup_corner_radius }}px;
    --popup-border-width: {{ settings.popup_border_thickness }}px;
    --popup-border-opacity: {{ settings.popup_border_opacity | divided_by: 100.0 }};

    /* Drawers */
    --drawer-border-width: {{ settings.drawer_border_thickness }}px;
    --drawer-border-opacity: {{ settings.drawer_border_opacity | divided_by: 100.0 }};

    /* Badges */
    --badge-radius: {{ settings.badge_corner_radius }}px;

    /* Brand information */
    --brand-image-width: {{ settings.brand_image_width }}px;
  }
{% endstyle %}
