{% doc %}
  Product card used in every product listing (collection, featured, search, related).
  Styles live in assets/critical.css (.fl-card).

  @param {object} product - product object
  @param {boolean} [show_quick_add] - override theme setting
  @param {string} [sizes] - sizes attribute for the image (default grid sizing)
  @param {string} [heading_level] - h2 or h3 (default h3); use h2 when the grid
    sits directly under the page h1, so the outline has no gap

  @example
  {% render 'product-card', product: product %}
  {% render 'product-card', product: product, heading_level: 'h2' %}
{% enddoc %}

{%- liquid
  assign quick = settings.card_quick_add
  if show_quick_add != nil
    assign quick = show_quick_add
  endif
  assign img_sizes = sizes | default: '(max-width: 749px) 50vw, (max-width: 989px) 33vw, 25vw'
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif

  # Theme setting: Product cards > Style. "Card" wraps the tile in its own
  # colour scheme and padding; "standard" leaves it bare.
  assign card_classes = 'fl-card'
  if settings.card_style == 'card'
    assign card_classes = card_classes | append: ' fl-card--boxed color-'
    assign card_classes = card_classes | append: settings.card_color_scheme
  endif

  # Theme setting: Animations > Hover effect. "default" means no motion.
  case settings.animations_hover_elements
    when 'vertical-lift'
      assign card_classes = card_classes | append: ' fl-card--lift'
    when 'zoom'
      assign card_classes = card_classes | append: ' fl-card--zoom'
  endcase

  # Theme setting: Badges > Position on cards. "top left" is the base rule.
  assign badge_classes = 'fl-card__badges'
  case settings.badge_position
    when 'top right'
      assign badge_classes = badge_classes | append: ' fl-card__badges--top-right'
    when 'bottom left'
      assign badge_classes = badge_classes | append: ' fl-card__badges--bottom-left'
    when 'bottom right'
      assign badge_classes = badge_classes | append: ' fl-card__badges--bottom-right'
  endcase
-%}

<article class="{{ card_classes }}">
  <div class="fl-card__media">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 900
        | image_tag: widths: '360, 540, 720, 900', sizes: img_sizes, alt: product.featured_media.alt, loading: 'lazy'
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'fl-card__placeholder' }}
    {%- endif -%}
    {%- if product.available == false or on_sale -%}
      <div class="{{ badge_classes }}">
        {%- if product.available == false -%}
          <span class="fl-badge fl-badge--soldout color-{{ settings.sold_out_badge_color_scheme }}">
            {{- settings.badge_soldout_label | default: 'Sold out' -}}
          </span>
        {%- elsif on_sale -%}
          <span class="fl-badge color-{{ settings.sale_badge_color_scheme }}">
            {{- settings.badge_sale_label | default: 'Sale' -}}
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="fl-card__info">
    {%- if settings.card_show_vendor and product.vendor != blank -%}
      <span class="fl-card__vendor">{{ product.vendor | escape }}</span>
    {%- endif -%}
    {%- assign card_heading = heading_level | default: 'h3' -%}
    <{{ card_heading }} class="fl-card__title">
      <a class="fl-card__link" href="{{ product.url }}">{{ product.title | escape }}</a>
    </{{ card_heading }}>
    {% render 'price', product: product %}
    {%- if quick and product.available -%}
      <div class="fl-card__quick">
        {% render 'quick-add', product: product %}
      </div>
    {%- endif -%}
  </div>
</article>
