{% stylesheet %}
  .fl-social {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    margin-inline-start: -12px;
    padding: 0;
    list-style: none;
  }

  .fl-social__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-muted);
    border-radius: var(--radius-btn);
    transition: color 0.15s ease;
  }

  .fl-social__link:hover {
    color: var(--color-ink);
  }
{% endstylesheet %}
