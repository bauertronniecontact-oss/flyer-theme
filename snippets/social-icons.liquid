{% doc %}
  Social media icon links built from theme settings (social_*).
  Renders nothing when no social URL is set.
  Icons: inline SVG, 20 px, stroke currentColor.
  Styles live in the snippet stylesheet (.fl-social).

  @param {string} [class] - extra class for the list wrapper

  @example
  {% render 'social-icons' %}
  {% render 'social-icons', class: 'fl-footer__social' %}
{% enddoc %}

{%- liquid
  assign has_social = false
  if settings.social_instagram != blank
    assign has_social = true
  endif
  if settings.social_tiktok != blank
    assign has_social = true
  endif
  if settings.social_facebook != blank
    assign has_social = true
  endif
  if settings.social_x != blank
    assign has_social = true
  endif
  if settings.social_pinterest != blank
    assign has_social = true
  endif
  if settings.social_youtube != blank
    assign has_social = true
  endif
  if settings.social_snapchat != blank
    assign has_social = true
  endif
  if settings.social_tumblr != blank
    assign has_social = true
  endif
  if settings.social_vimeo != blank
    assign has_social = true
  endif
  if settings.social_linkedin != blank
    assign has_social = true
  endif
-%}

{%- if has_social -%}
  <ul class="fl-social{% if class != blank %} {{ class }}{% endif %}" role="list">
    {%- if settings.social_instagram != blank -%}
      <li>
        <a
          class="fl-social__link"
          href="{{ settings.social_instagram }}"
          target="_blank"
          rel="noopener"
          aria-label="{{ 'general.social.instagram' | t }}"
        >
          <svg class="fl-social__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5"/>
            <circle cx="12" cy="12" r="4.2"/>
            <line x1="17.3" y1="6.7" x2="17.31" y2="6.7"/>
          </svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_tiktok != blank -%}
      <li>
        <a
          class="fl-social__link"
          href="{{ settings.social_tiktok }}"
          target="_blank"
          rel="noopener"
          aria-label="{{ 'general.social.tiktok' | t }}"
        >
          <svg class="fl-social__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
          </svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_facebook != blank -%}
