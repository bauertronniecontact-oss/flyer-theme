{% doc %}
  Social media icon links built from theme settings (social_*).
  Renders nothing when no social URL is set.
  Icons: inline SVG, 20 px, stroke currentColor.
  Styles live in the snippet stylesheet (.fl-social).

  @param {string} [class] - extra class for the list wrapper

  @example
  {% render 'social-icons' %}
  {% render 'social-icons', class: 'fl-footer__social' %}
{% enddoc %}

{%- liquid
  assign has_social = false
  if settings.social_instagram != blank
    assign has_social = true
  endif
  if settings.social_tiktok != blank
    assign has_social = true
  endif
  if settings.social_facebook != blank
    assign has_social = true
  endif
  if settings.social_x != blank
    assign has_social = true
  endif
  if settings.social_pinterest != blank
    assign has_social = true
  endif
  if settings.social_youtube != blank
    assign has_social = true
  endif
-%}

{%- if has_social -%}
  <ul class="fl-social{% if class != blank %} {{ class }}{% endif %}" role="list">
    {%- if settings.social_instagram != blank -%}
      <li>
        <a
          class="fl-social__link"
          href="{{ settings.social_instagram }}"
          target="_blank"
          rel="noopener"
          aria-label="{{ 'general.social.instagram' | t }}"
        >
          <svg class="fl-social__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5"/>
            <circle cx="12" cy="12" r="4.2"/>
            <line x1="17.3" y1="6.7" x2="17.31" y2="6.7"/>
          </svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_tiktok != blank -%}
      <li>
        <a
          class="fl-social__link"
          href="{{ settings.social_tiktok }}"
          target="_blank"
          rel="noopener"
          aria-label="{{ 'general.social.tiktok' | t }}"
        >
          <svg class="fl-social__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
          </svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_facebook != blank -%}
      <li>
        <a
          class="fl-social__link"
          href="{{ settings.social_facebook }}"
          target="_blank"
          rel="noopener"
          aria-label="{{ 'general.social.facebook' | t }}"
        >
          <svg class="fl-social__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_x != blank -%}
      <li>
        <a
          class="fl-social__link"
          href="{{ settings.social_x }}"
          target="_blank"
          rel="noopener"
          aria-label="{{ 'general.social.x' | t }}"
        >
          <svg class="fl-social__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M4 4l16 16"/>
            <path d="M20 4l-6.8 7.8"/>
            <path d="M10.8 12.2 4 20"/>
          </svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_pinterest != blank -%}
      <li>
        <a
          class="fl-social__link"
          href="{{ settings.social_pinterest }}"
          target="_blank"
          rel="noopener"
          aria-label="{{ 'general.social.pinterest' | t }}"
        >
          <svg class="fl-social__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M8 20l4-9"/>
            <path d="M10.7 14c.4 1 1.4 1.7 2.6 1.7 2.3 0 4.2-2 4.2-4.7C17.5 8 15.1 6 12.2 6 8.8 6 6.5 8.3 6.5 11.3c0 1.2.4 2.2 1.2 3"/>
          </svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_youtube != blank -%}
      <li>
        <a
          class="fl-social__link"
          href="{{ settings.social_youtube }}"
          target="_blank"
          rel="noopener"
          aria-label="{{ 'general.social.youtube' | t }}"
        >
          <svg class="fl-social__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
            <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>
          </svg>
        </a>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .fl-social {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    margin-inline-start: -12px;
    padding: 0;
    list-style: none;
  }

  .fl-social__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-muted);
    border-radius: var(--radius-btn);
    transition: color 0.15s ease;
  }

  .fl-social__link:hover {
    color: var(--color-ink);
  }
{% endstylesheet %}
